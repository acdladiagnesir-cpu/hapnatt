recette[exploitant]	formule	volume_vendu[exploitant, p] * tarif[exploitant]	FCFA	0	1e-3	non	annee	paliers	non
volume_vendu[exploitant,p]	formule	min(demande[usagers, p], capacite_installee[societe_de_patrimoine, p] * rendement[exploitant])	m3/an	0	1e-3	non	annee	paliers	non
tarif[exploitant]	table		FCFA/m3	500	1e-3	non	annee	interpolation	non
redevance[societe_de_patrimoine]	formule	volume_vendu[exploitant, p] * tarif[exploitant] * part_redevance[societe_de_patrimoine]	FCFA	0	1e-3	non	annee	paliers	non
part_redevance[societe_de_patrimoine]	formule	0.24	sans unité	0.24	1e-3	non	annee	paliers	non
