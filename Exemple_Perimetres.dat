capital_social[societe_de_patrimoine]	formule	1000000000	FCFA	0	1e-3	non	annee	paliers	non
tresorerie_depart[societe_de_patrimoine]	formule	1000000000	FCFA	0	1e-3	non	annee	paliers	non
ouvrages[societe_de_patrimoine]	formule	lag(ouvrages[societe_de_patrimoine]) + investissement[societe_de_patrimoine]	FCFA	0	1e-3	non	annee	paliers	non

