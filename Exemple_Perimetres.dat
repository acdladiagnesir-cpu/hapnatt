taux_actualisation	0.08
iterations_max	200
conserver_convergence	non
hors_table	derniere_valeur_avec_alerte
option_tarifs	
structures_equilibre	
hausse_max	
tri_cible	
structure_tri	
tresorerie_min	

[FONCTIONS]
nom	arguments	corps	description
annuite	montant, taux, duree	facteur = si(taux == 0, duree,\n    (1 - (1 + taux) ^ (-duree)) / taux)\nrésultat = montant / facteur	Remboursement annuel constant d'un emprunt.
amortissement_lineaire	montant, duree	résultat = montant / duree	Part annuelle d'un investissement amorti sur sa durée.
tarif_tranches	volume, prix_social, prix_normal, seuil	volume_social = min(volume, seuil)\nvolume_normal = max(volume - seuil, 0 * volume)\nrésultat = volume_social * prix_social\n    + volume_normal * prix_normal	Facture avec une tranche sociale jusqu'au seuil, puis une tranche normale.
indexation	prix, taux, annees	résultat = prix * (1 + taux) ^ annees	Prix augmenté d'un taux constant chaque année.
cout_ouvrage	type, taille, taille_reference, cout_reference	exposant = si(type == "usine", 0.7,\n    si(type == "forage", 0.8,\n    si(type == "reservoir", 0.6,\n    si(type == "conduite", 1,\n    si(type == "pompage", 0.65, 1)))))\nrésultat = cout_reference\n    * (taille / taille_reference) ^ exposant	Coût d'un ouvrage selon sa taille, avec économies d'échelle selon le type : "usine", "forage", "reservoir", "conduite", "pompage". Exposants indicatifs, à ajuster.

